{
  "name": "dsh-agent-mesh",
  "version": "0.1.1",
  "description": "DeepSeek Harness bundle for the agent-mesh P2P agent network",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./service": "./service.js",
    "./leader": "./leader.js",
    "./guidance": "./guidance.js",
    "./leader-tools": "./leader-tools.js",
    "./leader-provider": "./leader-provider.js",
    "./tools": "./tools.js",
    "./inbox": "./inbox.js"
  },
  "files": ["*.js", "lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm run build && node --test tests/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tool-subagent": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT"
}
